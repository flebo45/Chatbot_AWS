environment    = "production"
project_name   = "chatbot"
aws_region     = "YOUR_REGION"          # e.g. eu-central-1
lambda_runtime = "python3.12"

bedrock_model_arn = "arn:aws:bedrock:YOUR_REGION:YOUR_ACCOUNT_ID:foundation-model/anthropic.claude-v2"

# Knowledge Base (RAG)
embedding_model_arn  = "arn:aws:bedrock:YOUR_REGION::foundation-model/amazon.titan-embed-text-v2:0"
embedding_dimensions = 1024
embedding_data_type  = "FLOAT32"
s3vectors_data_type  = "float32"
