# Local .terraform directories
**/.terraform/*

# .tfstate files (NEVER commit these, they contain plaintext secrets!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (These contain environment-specific passwords/variables)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore backend config files (contain bucket names and account-specific values)
*.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Python ignores
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Ignore auto-generated zip files from Terraform archive_file block
*.zip

# OS hidden files
.DS_Store
Thumbs.db

# Kiro files
.kiro/

#vscode files
.vscode/

# python virtual environment
.venv/

# env file
.env

# TODO
todo.txt

# Deploy
deploy_frontend.sh